---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaLink from '../../components/CtaLink.astro';
import FaqList from '../../components/FaqList.astro';
import {
  accessStepsHe,
  benefitsHe,
  faqsHe,
  featureDeepDivesHe,
  featureOverviewHe,
  homeChromeHe,
  homeHeroHe,
  homeSeoHe,
  reasonsHe,
  requirementsHe,
} from '../../data/he/home';
import { routes } from '../../data/navigation';
import { absoluteUrl, faqPageJsonLd, softwareApplicationJsonLd } from '../../data/seo';
import { site } from '../../data/site';

export const prerender = true;
---

<BaseLayout
  seo={{
    title: homeSeoHe.title,
    description: homeSeoHe.description,
    canonicalPath: routes.heHome,
    jsonLd: [
      softwareApplicationJsonLd({
        url: absoluteUrl(routes.heHome),
        description: homeSeoHe.description,
      }),
      faqPageJsonLd(faqsHe),
    ],
  }}
>
  <section class="hero" id="hero" aria-labelledby="hero-heading">
    <div class="container hero__grid">
      <div class="hero__content">
        <h1 id="hero-heading">{homeHeroHe.h1}</h1>
        <p class="lede">{homeHeroHe.sentences.join(' ')}</p>
        <div class="hero__actions">
          <CtaLink />
          <CtaLink variant="secondary" href="#features" label={homeHeroHe.secondaryCta} />
        </div>
        <ul class="hero__labels">
          {homeHeroHe.labels.map((label) => <li>{label}</li>)}
        </ul>
      </div>
      <figure class="hero__media surface">
        <img
          src="/images/war-thunder-bomber-sunset.jpg"
          alt={homeChromeHe.heroAlt}
          width="596"
          height="335"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="band" id="benefits" aria-labelledby="benefits-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{homeChromeHe.benefitsEyebrow}</p>
        <h2 id="benefits-heading">{homeChromeHe.benefitsHeading}</h2>
      </div>
      <div class="benefit-grid">
        {
          benefitsHe.map((item) => (
            <article class="surface card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band--raised" id="features" aria-labelledby="features-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{homeChromeHe.featuresEyebrow}</p>
        <h2 id="features-heading">{homeChromeHe.featuresHeading}</h2>
        <p>{homeChromeHe.featuresIntro}</p>
      </div>
      <div class="feature-grid">
        {
          featureOverviewHe.map((feature) => (
            <article class="surface card">
              <h3>
                <a href={feature.href}>{feature.title}</a>
              </h3>
              <p>{feature.body}</p>
              <div class="cta-row">
                <CtaLink />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    featureDeepDivesHe.map((feature, index) => (
      <section
        class:list={['band', index % 2 === 1 && 'band--raised']}
        id={feature.id}
        aria-labelledby={`${feature.id}-heading`}
      >
        <div class="container split">
          <div>
            <p class="eyebrow">{feature.eyebrow}</p>
            <h2 id={`${feature.id}-heading`}>{feature.h2}</h2>
          </div>
          <div class="prose">
            {feature.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            <div class="cta-row">
              <CtaLink />
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="band band--raised" id="why" aria-labelledby="why-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{homeChromeHe.whyEyebrow}</p>
        <h2 id="why-heading">{homeChromeHe.whyHeading}</h2>
      </div>
      <div class="reason-grid">
        {
          reasonsHe.map((item) => (
            <article class="surface card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
      <div class="cta-row">
        <CtaLink />
      </div>
    </div>
  </section>

  <section class="band" id="start" aria-labelledby="start-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{homeChromeHe.startEyebrow}</p>
        <h2 id="start-heading">{homeChromeHe.startHeading}</h2>
      </div>
      <ol class="steps">
        {
          accessStepsHe.map((step, index) => (
            <li class="surface card">
              <p class="step-num">{String(index + 1).padStart(2, '0')}</p>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="cta-row">
        <CtaLink />
      </div>
    </div>
  </section>

  <section class="band band--raised" id="compatibility" aria-labelledby="compatibility-heading">
    <div class="container split">
      <div>
        <p class="eyebrow">{homeChromeHe.compatibilityEyebrow}</p>
        <h2 id="compatibility-heading">{homeChromeHe.compatibilityHeading}</h2>
        <p class="section-copy">{homeChromeHe.compatibilityCopy}</p>
      </div>
      <table>
        <caption class="sr-only">{homeChromeHe.compatibilityCaption}</caption>
        <tbody>
          {
            requirementsHe.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>{row.value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="container">
      <div class="cta-row">
        <CtaLink />
      </div>
    </div>
  </section>

  <section class="band" id="faq" aria-labelledby="faq-heading">
    <div class="container faq-layout">
      <div>
        <p class="eyebrow">{homeChromeHe.faqEyebrow}</p>
        <h2 id="faq-heading">{homeChromeHe.faqHeading}</h2>
        <p class="section-copy">{homeChromeHe.faqIntro}</p>
      </div>
      <FaqList items={faqsHe} />
    </div>
  </section>

  <section class="band close" id="cta" aria-labelledby="close-heading">
    <div class="container surface close-card">
      <p class="eyebrow">{site.product.claims.join(' · ')}</p>
      <h2 id="close-heading">{homeChromeHe.closeHeading}</h2>
      <p>{homeChromeHe.closeCopy}</p>
      <CtaLink />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-8) 0 var(--space-7);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 1px 0 var(--color-edge);
    background: var(--color-bg-transition);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .hero__media {
    margin: 0;
    overflow: hidden;
    width: 596px;
    max-width: 100%;
  }

  .hero__media img {
    width: 596px;
    max-width: 100%;
    height: auto;
  }

  .hero h1 {
    font-size: var(--text-3xl);
    max-width: 22rem;
  }

  .lede {
    margin-top: var(--space-4);
    max-width: 40rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .hero__labels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
    list-style: none;
  }

  .hero__labels li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .card h3 a {
    color: var(--color-text);
  }

  .card h3 a:hover {
    color: var(--color-accent-hover);
  }

  .cta-row {
    margin-top: var(--space-5);
  }

  .section-head {
    max-width: 40rem;
    margin-bottom: var(--space-6);
  }

  .section-head h2,
  .split h2,
  .faq-layout h2,
  .close-card h2 {
    margin-top: var(--space-3);
    font-size: var(--text-2xl);
  }

  .section-head p,
  .section-copy {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  .split {
    display: grid;
    gap: var(--space-5);
  }

  .prose {
    display: grid;
    gap: var(--space-4);
    color: var(--color-text-muted);
    max-width: 42rem;
  }

  .benefit-grid,
  .feature-grid,
  .reason-grid,
  .steps {
    display: grid;
    gap: var(--space-4);
    list-style: none;
  }

  .card h3 {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
  }

  .card p {
    color: var(--color-text-muted);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-surface);
    overflow: hidden;
  }

  th,
  td {
    padding: var(--space-3) var(--space-4);
    text-align: start;
    border-bottom: 1px solid var(--color-border);
  }

  tr:last-child th,
  tr:last-child td {
    border-bottom: 0;
  }

  th {
    width: 8.5rem;
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .step-num {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    margin-bottom: var(--space-3);
    direction: ltr;
    unicode-bidi: isolate;
  }

  .faq-layout {
    display: grid;
    gap: var(--space-6);
  }

  .close {
    padding-bottom: var(--space-8);
    background: var(--color-bg-lower);
  }

  .close-card {
    padding: var(--space-6);
  }

  .close-card p {
    margin: var(--space-4) 0 var(--space-5);
    max-width: 36rem;
    color: var(--color-text-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 48rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 596px);
      gap: var(--space-7);
      align-items: center;
    }

    .split,
    .faq-layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--space-7);
      align-items: start;
    }

    .benefit-grid,
    .feature-grid,
    .reason-grid {
      grid-template-columns: 1fr 1fr;
    }

    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
