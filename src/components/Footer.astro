---
import { site } from '../data/site';
import { footerNav, footerNavHe, liveItems } from '../data/navigation';
import { localeFromPath } from '../i18n/locale';
import { ui } from '../i18n/ui';
import SiteBrand from './SiteBrand.astro';

const locale = localeFromPath(Astro.url.pathname);
const copy = ui[locale];
const nav = locale === 'he' ? footerNavHe : footerNav;

const groups = [
  { title: copy.footerGroups.product, items: liveItems(nav.product) },
  { title: copy.footerGroups.features, items: liveItems(nav.features) },
  { title: copy.footerGroups.resources, items: liveItems(nav.resources) },
  { title: copy.footerGroups.legal, items: liveItems(nav.legal) },
].filter((group) => group.items.length > 0);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <SiteBrand compact />
      <p>{copy.tagline}</p>
    </div>

    {
      groups.length > 0 && (
        <div class="site-footer__nav">
          {groups.map((group) => (
            <nav aria-label={group.title}>
              <p class="site-footer__heading">{group.title}</p>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))}
        </div>
      )
    }
  </div>

  <div class="container site-footer__meta">
    <p>&copy; {year} {site.legalName}. {copy.footerCopyright}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-raised);
    padding: var(--space-7) 0 var(--space-5);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-6);
  }

  .site-footer__brand p {
    margin-top: var(--space-3);
    max-width: 22rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .site-footer__nav {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .site-footer__heading {
    margin: 0 0 var(--space-3);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .site-footer__nav ul {
    display: grid;
    gap: var(--space-2);
    list-style: none;
  }

  .site-footer__nav a {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .site-footer__meta {
    margin-top: var(--space-6);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  @media (min-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: minmax(12rem, 18rem) 1fr;
      align-items: start;
    }

    .site-footer__nav {
      grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    }
  }
</style>
