---
import { site } from '../data/site';
import { localeFromPath, localizePath } from '../i18n/locale';
import { ui } from '../i18n/ui';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const homeHref = localizePath('/', locale);
const homeAria = `${site.name} ${ui[locale].homeAria}`;
---

<a class:list={['brand', compact && 'brand--compact']} href={homeHref} aria-label={homeAria}>
  <img src="/favicon.svg" alt="" width="28" height="28" />
  <span class="brand__name">{site.name}</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    min-height: 2.5rem;
  }

  .brand:hover {
    color: var(--color-text);
  }

  .brand img {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    direction: ltr;
    unicode-bidi: isolate;
  }

  .brand--compact .brand__name {
    font-size: var(--text-xs);
  }
</style>
