---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaLink from '../../components/CtaLink.astro';
import UpdatedAsOf from '../../components/UpdatedAsOf.astro';
import {
  currentStatus,
  statusNotes,
  statusPage,
  statusRules,
  statusSeo,
  timezoneExamples,
  timezoneExplainer,
} from '../../data/status';
import { routes } from '../../data/navigation';
import { site } from '../../data/site';

export const prerender = true;

const breadcrumbs = [
  { name: 'Home', path: routes.home },
  { name: 'Undetected status', path: routes.undetected },
];
---

<BaseLayout
  seo={{
    title: statusSeo.title,
    description: statusSeo.description,
    canonicalPath: routes.undetected,
  }}
  breadcrumbs={breadcrumbs}
>
  <section class="band" id="status" aria-labelledby="status-heading">
    <div class="container status-hero">
      <p class="eyebrow">Live build</p>
      <h1 id="status-heading">{statusPage.h1}</h1>
      <p class="lede">{statusPage.lede}</p>

      <div class="status-board surface" role="status">
        <p class:list={['status-pill', `status-pill--${currentStatus.state}`]}>
          <span class="status-pill__dot" aria-hidden="true"></span>
          <span>Status: {currentStatus.label}</span>
        </p>
        <p class="status-play">{currentStatus.playLine}</p>
      </div>
    </div>
  </section>

  <section class="band band--raised" id="notes" aria-labelledby="notes-heading">
    <div class="container split">
      <div>
        <p class="eyebrow">After a patch</p>
        <h2 id="notes-heading">Rebuild notes</h2>
      </div>
      <div class="note-stack">
        {
          statusNotes.map((note) => (
            <article class="surface card">
              <h3>{note.title}</h3>
              <p>{note.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band" id="rules" aria-labelledby="rules-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Before you queue</p>
        <h2 id="rules-heading">How to use this page</h2>
      </div>
      <ol class="rule-list">
        {
          statusRules.map((rule) => (
            <li class="surface card">{rule}</li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band band--raised" id="timezone" aria-labelledby="timezone-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Local calendar</p>
        <h2 id="timezone-heading">{timezoneExplainer.heading}</h2>
        {
          timezoneExplainer.body.map((paragraph) => (
            <p class="section-copy">{paragraph}</p>
          ))
        }
      </div>

      <div class="tz-grid">
        <article class="surface card">
          <p class="tz-flag">Your device</p>
          <h3>Your timezone</h3>
          <UpdatedAsOf />
          <p>This is the stamp you should trust. It follows the timezone set on this browser or device.</p>
        </article>
        {
          timezoneExamples.map((example) => (
            <article class="surface card">
              <p class="tz-flag">
                <span aria-hidden="true">{example.flag}</span>
                {example.region}
              </p>
              <h3>{example.region}</h3>
              <UpdatedAsOf timeZone={example.timeZone} />
              <p>{example.note}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band close" aria-labelledby="status-close-heading">
    <div class="container surface close-card">
      <p class="eyebrow">{site.product.claims.join(' · ')}</p>
      <h2 id="status-close-heading">Get the overlay</h2>
      <p>
        One license for ESP, targeting, radar, and wallhack. Check this page after a
        patch, then play only while status is green.
      </p>
      <CtaLink />
    </div>
  </section>
</BaseLayout>

<style>
  .status-hero h1 {
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
    max-width: 16ch;
  }

  .lede,
  .section-copy,
  .status-play,
  .card p {
    color: var(--color-text-muted);
  }

  .lede {
    margin-top: var(--space-4);
    max-width: 40rem;
    font-size: var(--text-lg);
  }

  .status-board {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: var(--space-5);
    max-width: 36rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .status-pill__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: var(--radius-full);
    background: currentColor;
  }

  .status-pill--green {
    color: #8ee0b0;
    background: rgba(61, 191, 122, 0.12);
    border: 1px solid rgba(61, 191, 122, 0.35);
  }

  .status-pill--rebuilding {
    color: var(--color-accent);
    background: rgba(196, 178, 140, 0.1);
    border: 1px solid var(--color-border-strong);
  }

  .section-head {
    max-width: 42rem;
    margin-bottom: var(--space-6);
  }

  .section-head h2,
  .split h2,
  .close-card h2 {
    margin-top: var(--space-3);
    font-size: var(--text-2xl);
  }

  .section-copy {
    margin-top: var(--space-3);
  }

  .split {
    display: grid;
    gap: var(--space-5);
  }

  .note-stack,
  .rule-list,
  .tz-grid {
    display: grid;
    gap: var(--space-4);
    list-style: none;
  }

  .card h3,
  .tz-grid h3 {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
  }

  .tz-flag {
    margin-bottom: var(--space-2);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .close {
    padding-bottom: var(--space-8);
    background: var(--color-bg-lower);
  }

  .close-card {
    padding: var(--space-6);
  }

  .close-card p {
    margin: var(--space-4) 0 var(--space-5);
    max-width: 36rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--space-7);
      align-items: start;
    }

    .rule-list,
    .tz-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
