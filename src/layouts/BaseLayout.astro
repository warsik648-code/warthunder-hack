---
import '../styles/global.css';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import type { BreadcrumbEntry, PageSeoInput } from '../data/seo';
import { localeConfig, localeFromPath } from '../i18n/locale';
import { ui } from '../i18n/ui';

interface Props {
  seo?: PageSeoInput;
  breadcrumbs?: BreadcrumbEntry[];
  showBreadcrumbs?: boolean;
}

const { seo, breadcrumbs = [], showBreadcrumbs = breadcrumbs.length > 0 } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const { htmlLang, dir } = localeConfig[locale];
---

<!doctype html>
<html lang={htmlLang} dir={dir}>
  <head>
    <SeoHead seo={seo} breadcrumbs={breadcrumbs} />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui[locale].skipToContent}</a>
    <Header />
    <main id="main" class="site-main">
      {
        showBreadcrumbs && (
          <div class="container crumbs-wrap">
            <Breadcrumbs items={breadcrumbs} />
          </div>
        )
      }
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .crumbs-wrap {
    padding-top: var(--space-5);
  }
</style>
